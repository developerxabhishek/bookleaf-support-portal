# Copy this file to `.env` and fill in the values. Never commit `.env`.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (free M0 cluster is enough)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookleaf?retryWrites=true&w=majority

# Long random string used to sign session tokens, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Passwords for the demo accounts created by `npm run seed` (min 8 characters).
# The values below match the test credentials in README.md; use stronger ones for a public deployment.
SEED_ADMIN_PASSWORD=Admin@123
SEED_AUTHOR_PASSWORD=Author@123

# OpenAI. Leave OPENAI_API_KEY empty to run without AI: tickets fall back to
# rule-based triage and admins write replies manually.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# Ticket attachments (photos / PDFs) are stored in a private S3 bucket.
# Leave S3_BUCKET empty to run without attachments (tickets are text-only).
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible providers (Cloudflare R2, MinIO); leave empty for AWS S3.
S3_ENDPOINT=

# Only needed when the client is served from a different origin than the API
# (e.g. client on Vercel, API on Render). Leave empty when the API serves the client.
CLIENT_ORIGIN=
